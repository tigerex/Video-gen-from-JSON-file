        {
          "layer_id": "subtitle_text_4",
          "type": "text",
          "content": "Some words have their own unique comparative forms!",
          "font": "Open Sans",
          "size": 48,
          "color": "#DDDDDD",
          "position": {
            "x": 960,
            "y": 300,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 1,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_point_1_4",
          "type": "text",
          "content": "English has a few \"rebel\" adjectives that don't follow the rules. You just need to remember them!",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 450,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 2,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_2_4",
          "type": "text",
          "content": "Good becomes better",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 510,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 3.5,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_3_4",
          "type": "text",
          "content": "Example: \"This movie is good, but that one is better.\"",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 570,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 5,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_4_4",
          "type": "text",
          "content": "Bad becomes worse",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 630,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 6.5,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_5_4",
          "type": "text",
          "content": "Example: \"The weather today is bad, but yesterday it was worse.\"",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 690,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 8,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_6_4",
          "type": "text",
          "content": "Far becomes farther (for physical distance) or further (for abstract distance/additional)",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 750,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 9.5,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_7_4",
          "type": "text",
          "content": "Example: \"My house is farther than yours.\" / \"Do you have any further questions?\"",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 810,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
