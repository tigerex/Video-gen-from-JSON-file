            "direction": "topRight"
          }
        },
        {
          "layer_id": "title_text_2",
          "type": "text",
          "content": "How to Compare: Short Words (1 Syllable)",
          "font": "Merriweather",
          "size": 72,
          "color": "#FFFFFF",
          "position": {
            "x": 960,
            "y": 200,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 0.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "subtitle_text_2",
          "type": "text",
          "content": "Adding '-er' makes things *more*!",
          "font": "Open Sans",
          "size": 48,
          "color": "#DDDDDD",
          "position": {
            "x": 960,
            "y": 300,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 1,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_point_1_2",
          "type": "text",
          "content": "For most short adjectives (one syllable), we add -er to the end.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 450,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 2,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_2_2",
          "type": "text",
          "content": "Example: tall -> taller, fast -> faster, old -> older",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 510,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 3.5,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_3_2",
          "type": "text",
          "content": "Spelling Rules to Remember:",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 570,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 5,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_4_2",
          "type": "text",
          "content": "If the adjective ends in -e, just add -r. (Example: large -> larger, nice -> nicer)",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 630,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 6.5,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_5_2",
          "type": "text",
          "content": "If the adjective ends in consonant + vowel + consonant, double the last consonant and add -er. (Example: big -> bigger, hot -> hotter, thin -> thinner)",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 690,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 8,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_6_2",
          "type": "text",
          "content": "Let's try a few together!",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 750,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 9.5,
            "duration_sec": 0.5
          }
        }
      ]
    },
