        {
          "layer_id": "title_text_3",
          "type": "text",
          "content": "How to Compare: Long Words (2+ Syllables)",
          "font": "Merriweather",
          "size": 72,
          "color": "#FFFFFF",
          "position": {
            "x": 960,
            "y": 200,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 0.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "subtitle_text_3",
          "type": "text",
          "content": "When words are longer, we use 'more'!",
          "font": "Open Sans",
          "size": 48,
          "color": "#DDDDDD",
          "position": {
            "x": 960,
            "y": 300,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 1,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_point_1_3",
          "type": "text",
          "content": "For adjectives with two or more syllables, we use more before the adjective.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 450,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 2,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_2_3",
          "type": "text",
          "content": "Example: beautiful -> more beautiful, expensive -> more expensive, interesting -> more interesting",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 510,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 3.5,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_3_3",
          "type": "text",
          "content": "Important Note: We don't add '-er' to these longer words! (e.g., *not* \"beautifuller\")",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 570,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 5,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_4_3",
          "type": "text",
          "content": "Common 2-syllable exceptions ending in -y: Some 2-syllable adjectives ending in '-y' change 'y' to 'i' and add '-er'.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 630,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 6.5,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_5_3",
          "type": "text",
          "content": "Example: happy -> happier, easy -> easier, noisy -> noisier",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 690,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 8,
            "duration_sec": 0.5
          }
        },
        {
          "layer_id": "bullet_point_6_3",
          "type": "text",
          "content": "Practice time! What about \"comfortable\"?",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 100,
            "y": 750,
            "anchor": "left"
          },
          "animation": {
            "type": "slideInLeft",
            "startTime_sec": 9.5,
            "duration_sec": 0.5
          }
        }
      ]
