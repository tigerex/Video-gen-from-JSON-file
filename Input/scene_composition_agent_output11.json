        {
          "layer_id": "title_text_8",
          "type": "text",
          "content": "Comparatives in Real Life!",
          "font": "Merriweather",
          "size": 72,
          "color": "#FFFFFF",
          "position": {
            "x": 960,
            "y": 150,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 0.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "subtitle_text_8",
          "type": "text",
          "content": "Everyday Situations Where You'll Use Them",
          "font": "Open Sans",
          "size": 48,
          "color": "#E0E0E0",
          "position": {
            "x": 960,
            "y": 250,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 1.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_8_0",
          "type": "text",
          "content": "Describing people and places: 'My brother is taller than me.' 'The city is noisier than the countryside.'",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 440,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 3,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_8_1",
          "type": "text",
          "content": "Making choices and preferences: 'I prefer tea; it's healthier than soda.' 'This restaurant is better than the one we went to last week.'",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 510,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_8_2",
          "type": "text",
          "content": "Giving opinions: 'Learning a new language is more challenging than it looks.' 'This task is easier than the last one.'",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 580,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 7,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_8_3",
          "type": "text",
          "content": "Comparing products or services: 'This laptop is more expensive, but it's faster.' 'Their customer service is worse than their competitor's.'",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 650,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 9,
            "duration_sec": 1
          }
        }
      ]
    },
