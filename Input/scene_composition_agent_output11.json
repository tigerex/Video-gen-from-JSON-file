        {
          "layer_id": "title_text_9",
          "type": "text",
          "content": "Avoiding Pitfalls: Common Mistakes",
          "font": "Merriweather",
          "size": 72,
          "color": "#FFFFFF",
          "position": {
            "x": 960,
            "y": 150,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 0.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "subtitle_text_9",
          "type": "text",
          "content": "Be More Accurate, Be Less Confused!",
          "font": "Open Sans",
          "size": 48,
          "color": "#E0E0E0",
          "position": {
            "x": 960,
            "y": 250,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 1.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_9_0",
          "type": "text",
          "content": "Mistake 1: Double comparatives (e.g., 'more happier', 'more better'). Remember: only one comparative form per adjective!",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 405,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 3,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_9_1",
          "type": "text",
          "content": "Correction: 'happier', 'better'.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 475,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_9_2",
          "type": "text",
          "content": "Mistake 2: Confusing 'than' with 'then'. 'Than' is for comparison; 'then' is for time/sequence.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 545,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 7,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_9_3",
          "type": "text",
          "content": "Correction: 'taller THAN me' (comparison), 'first I ate, THEN I left' (time).",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 615,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 9,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_9_4",
          "type": "text",
          "content": "Mistake 3: Using '-er' for long adjectives or 'more' for short ones (e.g., 'beautifuler', 'more tall').",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 685,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 11,
            "duration_sec": 1
          }
        }
      ]
    },
