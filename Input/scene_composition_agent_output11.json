        {
          "layer_id": "title_text_7",
          "type": "text",
          "content": "Comparing Quantities: More, Less, Fewer",
          "font": "Merriweather",
          "size": 72,
          "color": "#FFFFFF",
          "position": {
            "x": 960,
            "y": 150,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 0.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "subtitle_text_7",
          "type": "text",
          "content": "For Nouns, Not Just Adjectives!",
          "font": "Open Sans",
          "size": 48,
          "color": "#E0E0E0",
          "position": {
            "x": 960,
            "y": 250,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 1.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_7_0",
          "type": "text",
          "content": "We also use 'more', 'less', and 'fewer' to compare quantities of nouns.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 370,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 3,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_7_1",
          "type": "text",
          "content": "Use 'more' for both countable and uncountable nouns.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 440,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_7_2",
          "type": "text",
          "content": "Example: I have more books than you. (Countable) / I need more information. (Uncountable)",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 510,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 7,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_7_3",
          "type": "text",
          "content": "Use 'fewer' for countable nouns (things you can count individually).",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 580,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 9,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_7_4",
          "type": "text",
          "content": "Example: There are fewer students in this class. / I have fewer problems now.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 650,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 11,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_7_5",
          "type": "text",
          "content": "Use 'less' for uncountable nouns (things you cannot count individually).",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 720,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 13,
            "duration_sec": 1
          }
        }
      ]
    },
    {
