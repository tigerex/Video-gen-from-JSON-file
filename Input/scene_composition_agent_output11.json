          }
        },
        {
          "layer_id": "bullet_text_1_1",
          "type": "text",
          "content": "Today, we'll learn how to compare things, people, and ideas using 'comparatives'.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
