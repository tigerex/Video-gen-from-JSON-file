            "direction": "bottomRight"
          }
        },
        {
          "layer_id": "title_text_2",
          "type": "text",
          "content": "What Are Comparatives, Anyway?",
          "font": "Merriweather",
          "size": 72,
          "color": "#FFFFFF",
          "position": {
            "x": 960,
            "y": 150,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 0.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "subtitle_text_2",
          "type": "text",
          "content": "Showing Differences and Similarities Clearly",
          "font": "Open Sans",
          "size": 48,
          "color": "#E0E0E0",
          "position": {
            "x": 960,
            "y": 250,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 1.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_2_0",
          "type": "text",
          "content": "Comparatives are words we use to compare two things, people, or ideas.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 440,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 3,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_2_1",
          "type": "text",
          "content": "They help us show which item has 'more' or 'less' of a certain quality.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 510,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_2_2",
          "type": "text",
          "content": "Think about describing: Is one city 'bigger' than another? Is this movie 'more interesting'?",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 580,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 7,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_2_3",
          "type": "text",
          "content": "They are essential for expressing preferences, making choices, and giving opinions.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 650,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 9,
            "duration_sec": 1
          }
        }
      ]
    },
    {
      "scene_id": 3,
      "slide_id": 3,
      "audioUrl": "https://drive.google.com/file/d/1sdZvrFKcacqTgfIx5ZQdBW5GyD4d-7zt/view?usp=drivesdk",
      "audioDuration_sec": 81.5,
      "layers": [
        {
          "layer_id": "image_bg_3",
          "type": "image",
          "url": "https://via.placeholder.com/1920x1080/424242/FFFFFF?text=Image+Not+Available",
          "animation": {
            "type": "KenBurns",
            "start_zoom": 1,
            "end_zoom": 1.08,
            "direction": "centerOut"
          }
        },
        {
          "layer_id": "title_text_3",
          "type": "text",
          "content": "Short & Sweet: One-Syllable Adjectives",
          "font": "Merriweather",
          "size": 72,
          "color": "#FFFFFF",
          "position": {
            "x": 960,
            "y": 150,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 0.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "subtitle_text_3",
          "type": "text",
          "content": "Just Add \"-er\"!",
          "font": "Open Sans",
          "size": 48,
          "color": "#E0E0E0",
          "position": {
            "x": 960,
            "y": 250,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 1.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_3_0",
          "type": "text",
          "content": "For most adjectives with one syllable, we simply add '-er' to the end.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 405,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 3,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_3_1",
          "type": "text",
          "content": "Example: tall → taller, old → older, fast → faster.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 475,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_3_2",
          "type": "text",
          "content": "Spelling Rule 1: If the adjective ends in consonant + vowel + consonant (CVC), double the last consonant before adding '-er'.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 545,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 7,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_3_3",
          "type": "text",
          "content": "Example: big → bigger, hot → hotter, thin → thinner.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 615,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 9,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_3_4",
          "type": "text",
          "content": "Spelling Rule 2: If the adjective ends in '-y', change 'y' to 'i' and then add '-er'.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 685,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 11,
            "duration_sec": 1
          }
        }
      ]
    },
    {
      "scene_id": 4,
      "slide_id": 4,
      "audioUrl": "https://drive.google.com/file/d/18tJlKjM-f2fA_1skhzfLpJJCX-M0v68Z/view?usp=drivesdk",
      "audioDuration_sec": 61.1,
      "layers": [
        {
          "layer_id": "image_bg_4",
          "type": "image",
          "url": "https://drive.google.com/file/d/1hpl8Otclm_lBFWQVXoQVCO3yZGqn2Y2s/view?usp=drivesdk",
          "animation": {
            "type": "KenBurns",
            "start_zoom": 1,
            "end_zoom": 1.08,
            "direction": "topRight"
          }
        },
        {
          "layer_id": "title_text_4",
          "type": "text",
          "content": "Longer Words, Different Rules",
          "font": "Merriweather",
          "size": 72,
          "color": "#FFFFFF",
          "position": {
            "x": 960,
            "y": 150,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 0.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "subtitle_text_4",
          "type": "text",
          "content": "Using \"More\" or \"Less\"",
          "font": "Open Sans",
          "size": 48,
          "color": "#E0E0E0",
          "position": {
            "x": 960,
            "y": 250,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 1.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_4_0",
          "type": "text",
          "content": "For adjectives with two or more syllables (that don't end in -y), we do NOT add '-er'.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 405,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 3,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_4_1",
          "type": "text",
          "content": "Instead, we put 'more' before the adjective to show a greater degree.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 475,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_4_2",
          "type": "text",
          "content": "Example: beautiful → more beautiful, expensive → more expensive, important → more important.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 545,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 7,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_4_3",
          "type": "text",
          "content": "To show a lesser degree, we use 'less' before the adjective.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 615,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 9,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_4_4",
          "type": "text",
          "content": "Example: difficult → less difficult, comfortable → less comfortable.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 685,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 11,
            "duration_sec": 1
          }
        }
      ]
    },
    {
      "scene_id": 5,
      "slide_id": 5,
      "audioUrl": "https://drive.google.com/file/d/16u5GMqI2YUO-2_--1Cg5khPrsmfONgUA/view?usp=drivesdk",
      "audioDuration_sec": 75.1,
      "layers": [
        {
          "layer_id": "image_bg_5",
          "type": "image",
          "url": "https://drive.google.com/file/d/1T3Kk3gidlOs5Gtbvqf8CCBA73U92vOS7/view?usp=drivesdk",
          "animation": {
            "type": "KenBurns",
            "start_zoom": 1,
            "end_zoom": 1.08,
            "direction": "bottomLeft"
          }
        },
        {
          "layer_id": "title_text_5",
          "type": "text",
          "content": "The \"Special\" Ones: Irregular Comparatives",
          "font": "Merriweather",
          "size": 72,
          "color": "#FFFFFF",
          "position": {
            "x": 960,
            "y": 150,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 0.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "subtitle_text_5",
          "type": "text",
          "content": "No Rules, Just Remember!",
          "font": "Open Sans",
          "size": 48,
          "color": "#E0E0E0",
          "position": {
            "x": 960,
            "y": 250,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 1.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_5_0",
          "type": "text",
          "content": "Some adjectives don't follow the regular '-er' or 'more/less' rules. They change completely!",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 370,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 3,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_5_1",
          "type": "text",
          "content": "These are called irregular comparatives, and you need to memorize them.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 440,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_5_2",
          "type": "text",
          "content": "Good → Better (Example: This book is better than that one.)",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 510,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 7,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_5_3",
          "type": "text",
          "content": "Bad → Worse (Example: The weather today is worse than yesterday.)",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 580,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 9,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_5_4",
          "type": "text",
          "content": "Far → Farther / Further (Example: My house is farther/further from here.)",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 650,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 11,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_5_5",
          "type": "text",
          "content": "Little (quantity) → Less (Example: I have less time now.)",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 720,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 13,
            "duration_sec": 1
          }
        }
      ]
    },
    {
      "scene_id": 6,
      "slide_id": 6,
      "audioUrl": "https://drive.google.com/file/d/10GI1wF5fPhChkN6YyxLS2ov930O4f3Qx/view?usp=drivesdk",
      "audioDuration_sec": 73.9,
      "layers": [
        {
          "layer_id": "image_bg_6",
          "type": "image",
          "url": "https://drive.google.com/file/d/1QOTvfnT0ks7v1OZc3XLIw-Blr9QtbNpA/view?usp=drivesdk",
          "animation": {
            "type": "KenBurns",
            "start_zoom": 1,
            "end_zoom": 1.08,
            "direction": "centerIn"
          }
        },
        {
          "layer_id": "title_text_6",
          "type": "text",
          "content": "Connecting Your Comparisons with \"Than\"",
          "font": "Merriweather",
          "size": 72,
          "color": "#FFFFFF",
          "position": {
            "x": 960,
            "y": 150,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 0.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "subtitle_text_6",
          "type": "text",
          "content": "The Essential Word for Showing Difference",
          "font": "Open Sans",
          "size": 48,
          "color": "#E0E0E0",
          "position": {
            "x": 960,
            "y": 250,
            "anchor": "center"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 1.5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_6_0",
          "type": "text",
          "content": "When you compare two things, you almost always use the word 'than' to link them.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 370,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 3,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_6_1",
          "type": "text",
          "content": "It helps us clearly state what we are comparing one item to.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 440,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 5,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_6_2",
          "type": "text",
          "content": "Sentence structure: Item 1 + verb + comparative adjective + THAN + Item 2.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 510,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 7,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_6_3",
          "type": "text",
          "content": "Example: My new phone is faster than my old one.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 580,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 9,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_6_4",
          "type": "text",
          "content": "Example: Learning English is more interesting than I thought!",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 650,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 11,
            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_6_5",
          "type": "text",
          "content": "Remember: It's 'than', not 'then'!",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
            "x": 150,
            "y": 720,
            "anchor": "left"
          },
          "animation": {
            "type": "fadeIn",
            "startTime_sec": 13,
            "duration_sec": 1
          }
        }
      ]
    },
    {
      "scene_id": 7,
