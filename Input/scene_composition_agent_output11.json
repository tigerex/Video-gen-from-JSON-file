            "duration_sec": 1
          }
        },
        {
          "layer_id": "bullet_text_11_2",
          "type": "text",
          "content": "Don't forget the irregulars (good → better, bad → worse) and always use 'than' to connect your comparisons.",
          "font": "Open Sans",
          "size": 36,
          "color": "#FFFFFF",
          "position": {
